{
  "name": "Lousa TeX",
  "short_name": "Lousa TeX",
  "description": "Editor de apresentações com LaTeX nativo e editável",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f1f3f4",
  "theme_color": "#b25c1c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.lousa-tex+json": [".lousa"] },
      "icons": [ { "src": "icons/file-lousa.png", "sizes": "256x256", "type": "image/png" } ],
      "launch_type": "multiple-clients"
    }
  ]
}
